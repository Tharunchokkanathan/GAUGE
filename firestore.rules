rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shared recipe & food database: Readable by any authenticated user
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin SDK can write shared recipes
    }

    match /foods/{foodId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin SDK can write shared foods
    }

    // User-specific data: Strictly isolated by Firebase Auth UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
