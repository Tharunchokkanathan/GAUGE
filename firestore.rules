rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile, Daily Logs, Favorites, Custom Recipes & History isolation
    match /users/{userId} {
      // User profile document: only owner can read or write
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Daily nutrition logs & meal history: only owner can access
      match /dailyLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Saved Favorites: only owner can access
      match /favorites/{favId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Custom Recipes: only owner can access
      match /customRecipes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Shared Recipe Catalog: public read, admin write
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Shared Food Database: public read, admin write
    match /foods/{foodId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
